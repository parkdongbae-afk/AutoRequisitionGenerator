{
  "name": "shopping-mall-rule-manager",
  "version": "0.2.0",
  "productName": "쇼핑몰 규칙 관리자",
  "description": "단독 실행형 쇼핑몰 규칙 관리 프로그램 (ADMIN_SATAD_ALONE.MD)",
  "main": "./out/main/index.js",
  "author": "dongbae",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke"
  },
  "build": {
    "appId": "kr.school.shopping-mall-rule-manager",
    "productName": "쇼핑몰 규칙 관리자",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "ShoppingMallRuleManager-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "xlsx": "0.18.5"
  }
}
