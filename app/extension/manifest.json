{
  "manifest_version": 3,
  "name": "품의캡처",
  "version": "1.6.4",
  "description": "현재 주문/장바구니 페이지를 캡처하여 '자동 품의 요구 생성기' 데스크톱 앱으로 전송합니다. Chrome·Edge·웨일 호환.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "pageCapture",
    "activeTab",
    "bookmarks",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:57330/*",
    "http://127.0.0.1:57331/*",
    "http://127.0.0.1:57332/*",
    "http://127.0.0.1:57333/*",
    "http://127.0.0.1:57334/*",
    "http://127.0.0.1:57335/*"
  ],
  "action": {
    "title": "품의캡처",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
