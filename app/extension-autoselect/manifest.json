{
  "manifest_version": 3,
  "name": "물품 자동 선택",
  "version": "1.0.9",
  "description": "장바구니에서 품목내역(행정실용)과 일치하는 상품만 자동으로 선택(V체크)합니다. 엑셀 내용은 로컬에서만 읽습니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "물품 자동 선택",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.11st.co.kr/cart*",
    "*://*.aladin.co.kr/*",
    "*://*.alpha.co.kr/order/cart*",
    "*://*.cart.auction.co.kr/*",
    "*://*.cart.gmarket.co.kr/*",
    "*://*.coupang.com/*",
    "*://*.daisomall.co.kr/*",
    "*://*.dreamdepot.co.kr/*",
    "*://*.i-screammall.co.kr/order/cart*",
    "*://*.officedepot.co.kr/*",
    "*://*.order.kyobobook.co.kr/cart*",
    "*://*.screammall.co.kr/order/cart*",
    "*://*.shopping.naver.com/cart*",
    "*://*.teacherville.co.kr/order/cart*",
    "*://*.yes24.com/dMyCart/CartMain*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.11st.co.kr/cart*",
        "*://*.aladin.co.kr/*",
        "*://*.alpha.co.kr/order/cart*",
        "*://*.cart.auction.co.kr/*",
        "*://*.cart.gmarket.co.kr/*",
        "*://*.coupang.com/*",
        "*://*.daisomall.co.kr/*",
        "*://*.dreamdepot.co.kr/*",
        "*://*.i-screammall.co.kr/order/cart*",
        "*://*.officedepot.co.kr/*",
        "*://*.order.kyobobook.co.kr/cart*",
        "*://*.screammall.co.kr/order/cart*",
        "*://*.shopping.naver.com/cart*",
        "*://*.teacherville.co.kr/order/cart*",
        "*://*.yes24.com/dMyCart/CartMain*"
      ],
      "js": ["content/core.js", "content/rules-data.js", "content/cart-router.js"],
      "run_at": "document_idle"
    }
  ]
}
