{
  "id": "officedepot",
  "name": "오피스디포",
  "match": [
    "officedepot.co.kr"
  ],
  "rowSelector": "tr:has(input.itemId)",
  "checkedOnly": {
    "sel": "input.itemId"
  },
  "fields": {
    "name": {
      "sel": "p.name a"
    },
    "qty": {
      "sel": "input.itemCount",
      "attr": "value"
    },
    "price": {
      "sel": "span.price:not(.rowPrice)",
      "regex": "([\\d,]+)"
    }
  },
  "shipping": {
    "mode": "conditional",
    "fee": 3000,
    "freeOver": 30000
  },
  "notes": "오피스디포 장바구니. V체크된 상품만 추출. 배송비는 30,000원 이상 구매 시 무료, 미만 3,000원(2026-09-26 사용자 제공 정책 — 조건부 모드)."
}
