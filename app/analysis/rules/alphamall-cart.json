{
  "id": "alphamall-cart",
  "name": "알파몰 장바구니",
  "match": [
    "alpha.co.kr/order/cart"
  ],
  "rowSelector": "table.list-product-a tbody tr:has(input.chk-row)",
  "checkedOnly": {
    "sel": "input.chk-row"
  },
  "fields": {
    "name": {
      "sel": "p.name"
    },
    "qty": {
      "sel": "input[name=CP_CNTs]",
      "attr": "value"
    },
    "price": {
      "sel": "p.price-after strong",
      "regex": "([\\d,]+)원"
    }
  },
  "shipping": {
    "mode": "selector",
    "sel": "td div.labels p strong",
    "regex": "([\\d,]+)원"
  },
  "notes": "알파몰 장바구니. V체크된 상품만 추출. 배송비는 판매자 그룹별 표시값 합계 — 50,000원 이상 그룹은 페이지가 0원으로 표시(2026-09-26 사용자 제공 정책)."
}
