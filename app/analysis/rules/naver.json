{
  "id": "naver",
  "name": "네이버쇼핑",
  "match": [
    "pay.naver.com",
    "smartstore.naver.com",
    "order.naver.com",
    "cart.naver.com"
  ],
  "rowSelector": "[class*=ProductItem_article]",
  "priceIs": "lineTotal",
  "fields": {
    "name": {
      "sel": "[class*=ProductDetail_name]",
      "regex": "상품명\\s*(.+)"
    },
    "qty": {
      "sel": "[class*=ProductOption_amount-option]",
      "regex": "(\\d+)개"
    },
    "price": {
      "sel": "[class*=ProductOption_price-final]",
      "regex": "([\\d,]+)원"
    },
    "option": {
      "sel": "[class*=ProductOption_name]"
    }
  },
  "shipping": {
    "mode": "selector",
    "sel": "[class*=ProductStore_delivery]",
    "regex": "([\\d,]+)원"
  },
  "notes": "CSS모듈 해시클래스 - prefix 매칭. ProductStore_delivery는 판매자그룹별 배송비. 행 안의 ProductOption_article 블록이 본 옵션+추가상품마다 반복되므로 units로 각각 품목화(2026-09-26 추가상품 미추출 수정)",
  "units": {
    "sel": "[class*=ProductOption_article]"
  }
}
